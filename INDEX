  <meta property="og:title" content="Virendrra Randive – Advisor & Entrepreneur" />
  <meta property="og:description" content="Advisor and founder at Laxmi Jute House, helping businesses with sustainable corporate gifting and growth strategy." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://virendra-portfolio592.netlify.app/" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Virendrra Randive – Advisor & Entrepreneur" />
  <meta name="twitter:description" content="Advisor and founder at Laxmi Jute House, helping businesses with sustainable corporate gifting and growth strategy." />

  <!-- Premium Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

  <!-- Simple favicon -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23d4af37'/%3E%3Ctext x='16' y='22' font-size='16' font-family='system-ui,sans-serif' font-weight='700' fill='%230a0a0a' text-anchor='middle'%3EV%3C/text%3E%3C/svg%3E" />

  <style>
    :root {
      /* High-End Midnight & Gold Palette */
      --bg: #0a0a0a;
      --bg-alt: #121212;
      --accent: #d4af37;
      --accent-soft: rgba(212, 175, 55, 0.1);
      --text: #f0f0f0;
      --muted: #9ca3af;
      --card: #151515;
      --border: rgba(255, 255, 255, 0.08);
      --radius-xl: 18px;
      --shadow-soft: 0 22px 40px rgba(0, 0, 0, 0.4);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }

    h1, h2, h3, .brand-text span:first-child, .hero-title {
      font-family: 'Playfair Display', serif;
      letter-spacing: -0.01em;
      font-weight: 500;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      width: 100%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Scroll Animations */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.9s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* SVG Icons */
    svg.icon {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }

    /* Nav */
    .nav {
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      background: rgba(10, 10, 10, 0.85);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 0;
      gap: 1.5rem;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .brand-logo {
      width: 36px;
      height: 36px;
      border-radius: 999px;
      background: linear-gradient(135deg, #d4af37, #b8972e);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      font-family: 'Playfair Display', serif;
      font-weight: 600;
      color: #0a0a0a;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-text span:first-child {
      font-size: 1.1rem;
    }

    .brand-text span:last-child {
      font-size: 0.75rem;
      color: var(--muted);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      font-size: 0.9rem;
    }

    .nav-links a {
      padding: 0.4rem 0.6rem;
      color: var(--muted);
      transition: color 0.3s ease;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .nav-cta {
      padding: 0.6rem 1.2rem;
      border-radius: 999px;
      font-size: 0.85rem;
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      white-space: nowrap;
    }

    .nav-cta:hover {
      background: var(--accent);
      color: #0a0a0a;
    }

    .nav-toggle {
      display: none;
      border: none;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }

    .nav-toggle svg {
      width: 24px;
      height: 24px;
    }

    main {
      flex: 1;
    }

    /* Hero */
    .hero {
      padding: 6rem 0 4rem;
      background: radial-gradient(circle at top, #151515 0, #0a0a0a 60%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.1fr);
      gap: 4rem;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-soft);
      border: 1px solid rgba(212, 175, 55, 0.3);
    }

    .eyebrow-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: var(--accent);
    }

    .hero-title {
      margin: 1.2rem 0 1rem;
      font-size: clamp(2.5rem, 4.5vw, 3.8rem);
      line-height: 1.15;
    }

    .hero-title span.highlight {
      color: var(--accent);
      font-style: italic;
    }

    .hero-subtitle {
      font-size: 1.05rem;
      line-height: 1.7;
      max-width: 36rem;
      color: var(--muted);
    }

    .hero-subtitle strong {
      color: #fff;
      font-weight: 500;
    }

    .metrics {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin: 2rem 0 1rem;
    }

    .metric {
      padding: 1rem 1.2rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      min-width: 150px;
    }

    .metric strong {
      display: block;
      font-size: 1.4rem;
      font-family: 'Playfair Display', serif;
      color: var(--accent);
    }

    .metric span {
      font-size: 0.8rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2rem;
      align-items: center;
    }

    .btn {
      border-radius: 999px;
      padding: 0.85rem 1.6rem;
      font-size: 0.95rem;
      border: 1px solid transparent;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: #0a0a0a;
      box-shadow: 0 10px 20px rgba(212, 175, 55, 0.2);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 25px rgba(212, 175, 55, 0.3);
      background: #e5c358;
    }

    .btn-outline {
      background: transparent;
      color: var(--text);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-outline:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .hero-note {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 1.2rem;
      font-size: 0.85rem;
      color: var(--muted);
    }

    .hero-visual {
      position: relative;
    }

    .hero-card {
      position: relative;
      border-radius: 20px;
      padding: 2rem;
      background: linear-gradient(145deg, #181818, #0a0a0a);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
      overflow: hidden;
      min-height: 300px;
    }

    .hero-avatar {
      width: 80px;
      height: 80px;
      border-radius: 999px;
      background: linear-gradient(135deg, #d4af37, #b8972e);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      font-family: 'Playfair Display', serif;
      color: #0a0a0a;
      margin-bottom: 1.2rem;
    }

    .hero-card h2 {
      margin: 0 0 0.5rem;
      font-size: 1.4rem;
      color: #fff;
    }

    .hero-card p {
      margin: 0;
      font-size: 0.95rem;
      color: var(--muted);
      line-height: 1.6;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.5rem;
      font-size: 0.8rem;
    }

    .tag {
      padding: 0.4rem 0.8rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #d1d5db;
    }

    .hero-floating-card {
      position: absolute;
      right: -15px;
      bottom: -15px;
      padding: 1.2rem;
      border-radius: 16px;
      background: rgba(18, 18, 18, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      box-shadow: 0 15px 35px rgba(0,0,0,0.6);
      font-size: 0.85rem;
      max-width: 220px;
    }

    .hero-floating-card strong {
      display: block;
      font-size: 0.95rem;
      margin-bottom: 0.4rem;
      color: var(--accent);
      font-family: 'Playfair Display', serif;
    }

    .hero-floating-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      background: var(--accent-soft);
      border: 1px solid rgba(212, 175, 55, 0.3);
      color: var(--accent);
      font-size: 0.75rem;
      margin-top: 0.8rem;
    }

    /* Sections */
    section {
      padding: 5rem 0;
    }

    section:nth-of-type(even) {
      background: var(--bg-alt);
    }

    .section-header {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 3rem;
      align-items: center;
      text-align: center;
    }

    .section-kicker {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--accent);
    }

    .section-title {
      font-size: 2.2rem;
      margin: 0;
    }

    .section-description {
      font-size: 1rem;
      color: var(--muted);
      max-width: 38rem;
      margin: 0.5rem auto 0;
    }

    /* About */
    .about-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: center;
    }

    .about-text p {
      margin: 0 0 1.2rem;
      font-size: 1.05rem;
      color: #e5e7eb;
    }

    .about-text p span.muted {
      color: var(--muted);
    }

    .about-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      font-size: 0.9rem;
    }

    .about-item {
      padding: 1.2rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.02);
    }

    .about-item span.label {
      display: block;
      font-size: 0.75rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.3rem;
    }

    .about-item span.value {
      font-weight: 500;
      color: #fff;
    }

    .stack-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1rem;
      font-size: 0.85rem;
    }

    .stack-tags span {
      padding: 0.4rem 0.8rem;
      border-radius: 999px;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--muted);
    }

    /* Services */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .card {
      background: var(--card);
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      padding: 2.5rem 2rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      transition: transform 0.4s ease, border-color 0.4s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: rgba(212, 175, 55, 0.4);
    }

    .card-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: var(--accent-soft);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .card h3 {
      margin: 0 0 1rem;
      font-size: 1.3rem;
    }

    .card p {
      margin: 0 0 1.5rem;
      font-size: 0.95rem;
      color: var(--muted);
    }

    .card ul {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 0.9rem;
      color: #e5e7eb;
    }

    .card ul li {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.6rem;
    }

    .card ul li::before {
      content: "—";
      color: var(--accent);
    }

    /* Highlight / Work */
    .highlight {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: flex-start;
    }

    .highlight h3 {
      margin: 0 0 1rem;
      font-size: 1.8rem;
    }

    .highlight p {
      font-size: 1.05rem;
      color: var(--muted);
      margin-bottom: 2rem;
    }

    .product-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .product-chip {
      border-radius: 12px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.02);
      padding: 0.5rem;
      text-align: center;
      transition: all 0.3s ease;
    }

    .product-chip:hover {
      border-color: var(--accent);
      background: rgba(212, 175, 55, 0.05);
    }

    .product-chip img {
      width: 100%;
      height: 90px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 0.5rem;
    }

    .product-chip .label {
      font-size: 0.75rem;
      color: var(--muted);
      display: block;
      padding-bottom: 0.2rem;
    }

    .highlight-card {
      border-radius: 20px;
      padding: 2.5rem;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
    }

    .highlight-card-header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .highlight-card-title {
      font-size: 1.2rem;
      font-family: 'Playfair Display', serif;
      color: #fff;
      margin-bottom: 0.5rem;
    }

    .highlight-card-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .highlight-card-list li {
      margin-bottom: 1rem;
      font-size: 0.9rem;
      color: #e5e7eb;
    }

    .highlight-card-list span.label {
      display: block;
      color: var(--accent);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.2rem;
    }

    /* Clients: featured badges */
    .client-featured-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.9rem;
      margin: 1.5rem 0 0;
    }

    .client-featured-chip {
      padding: 0.9rem 0.7rem;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.22), rgba(212, 175, 55, 0.06));
      border: 1.5px solid rgba(212, 175, 55, 0.55);
      font-size: 0.82rem;
      font-weight: 600;
      text-align: center;
      color: #f3d876;
      box-shadow: 0 8px 18px rgba(212, 175, 55, 0.08);
    }

    /* Clients: grouped list by industry */
    .client-groups-wrap {
      background: var(--card);
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      padding: 2.5rem;
      box-shadow: var(--shadow-soft);
      margin-top: 3rem;
    }

    .client-groups-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 3rem;
      margin-top: 1.8rem;
    }

    .client-group {
      margin-top: 0;
    }

    .client-group-title {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 0.6rem;
      font-weight: 600;
    }

    .clients-list {
      margin: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.4rem;
      font-size: 0.88rem;
      color: #d1d5db;
      padding: 0;
      list-style: none;
    }

    .clients-list li {
      position: relative;
      padding-left: 1rem;
    }

    .clients-list li::before {
      content: "◆";
      position: absolute;
      left: 0;
      top: 0.2rem;
      font-size: 0.5rem;
      color: var(--accent);
    }

    .clients-note {
      font-size: 0.82rem;
      color: var(--muted);
      margin-top: 2rem;
      padding-top: 1.6rem;
      border-top: 1px solid var(--border);
      grid-column: 1 / -1;
    }

    /* Testimonials */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .testimonial {
      border-radius: 16px;
      border: 1px solid var(--border);
      background: var(--card);
      padding: 2rem;
    }

    .testimonial-quote {
      color: #e5e7eb;
      font-size: 0.95rem;
      font-style: italic;
      margin-bottom: 1.5rem;
    }

    .testimonial-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .testimonial-name {
      font-weight: 500;
      color: #fff;
      font-size: 0.9rem;
    }

    .testimonial-role {
      color: var(--muted);
      font-size: 0.8rem;
    }

    /* Contact */
    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 4rem;
    }

    .contact-card {
      border-radius: 20px;
      padding: 2.5rem;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .contact-card h3 {
      font-size: 1.5rem;
      margin-top: 0;
    }

    .contact-list {
      list-style: none;
      padding: 0;
      margin: 2rem 0;
    }

    .contact-list li {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.2rem;
      color: #e5e7eb;
      font-size: 0.95rem;
    }

    .contact-list li .icon {
      color: var(--accent);
    }

    .response-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
      padding: 0.5rem 0.9rem;
      border-radius: 999px;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.4);
      color: #86efac;
      font-size: 0.8rem;
    }

    form {
      display: grid;
      gap: 1.2rem;
    }

    input, textarea {
      width: 100%;
      font-family: inherit;
      font-size: 0.95rem;
      padding: 0.8rem 1rem;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      outline: none;
      transition: all 0.3s ease;
    }

    input:focus, textarea:focus {
      border-color: var(--accent);
      background: rgba(255, 255, 255, 0.05);
    }

    textarea {
      min-height: 150px;
      resize: vertical;
    }

    .form-row-inline {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.2rem;
    }

    /* Footer */
    footer {
      border-top: 1px solid var(--border);
      padding: 2rem 0;
      font-size: 0.85rem;
      color: var(--muted);
      background: #050505;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
    }

    .footer-links a:hover {
